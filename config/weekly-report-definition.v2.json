{
  "schemaVersion": 2,
  "layouts": {
    "weekly-report": {
      "description": "Weekly status-report placement preview",
      "presentation": {
        "showWorksheetSummaryBand": false,
        "showFeatureSummary": false
      },
      "remarks": {
        "source": "tfsDiscussionMarker",
        "marker": "[WeeklyReport]",
        "clearMarker": "[WeeklyReport][Clear]",
        "maxLength": 32767
      },
      "source": {
        "areaPaths": [
          "SupplyPro.Core\\Enterprise Software Team\\Agent7",
          "SupplyPro.Core\\Enterprise Software Team\\CDR",
          "SupplyPro.Core\\Enterprise Software Team\\SSIS",
          "SupplyPro.Core\\Enterprise Software Team\\Mobile",
          "SupplyPro.Core\\Enterprise Software Team\\NextGen"
        ],
        "match": "exact"
      },
      "filters": {
        "types": [
          "Product Backlog Item",
          "Bug",
          "Feature"
        ],
        "excludeStates": [
          "Removed",
          "Done"
        ],
        "requiredTags": [],
        "requiredTagsMode": "all"
      },
      "releaseSelection": {
        "strategy": "highestNumericTag",
        "fallback": "storedRelease"
      },
      "limits": {
        "candidateRows": 5000,
        "includedRows": 2000
      },
      "tabs": [
        {
          "key": "agent7",
          "name": "Agent7",
          "order": 10,
          "sections": [
            {
              "key": "weekly-items",
              "name": "Weekly Items",
              "order": 10,
              "grouping": {
                "levels": [
                  "release",
                  "feature"
                ],
                "includeStandaloneItems": true
              }
            }
          ]
        },
        {
          "key": "cdr",
          "name": "CDR",
          "order": 20,
          "sections": [
            {
              "key": "weekly-items",
              "name": "Weekly Items",
              "order": 10,

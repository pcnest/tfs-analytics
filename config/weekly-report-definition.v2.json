                  "feature"
                ],
                "includeStandaloneItems": true
              }
            }
          ]
        },
        {
          "key": "ssis",
          "name": "SSIS",
          "order": 30,
          "sections": [
            {
              "key": "weekly-items",
              "name": "Weekly Items",
              "order": 10,
              "grouping": {
                "levels": [
                  "release",
                  "feature"
                ],
                "includeStandaloneItems": true
              }
            }
          ]
